### Produto: buscar por ID (sucesso)
GET {{host}}/produtos/{{livroId}}

> {%
    client.test("200 com o produto pedido", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.id === Number(client.global.get("livroId")), "id " + response.body.id);
    });
%}

### Produto: listar por categoria (sucesso)
GET {{host}}/produtos?categoria=LIVROS

> {%
    client.test("200, só LIVROS, ordenada por sku, contém o livro", function () {
        var lista = response.body;
        client.assert(response.status === 200, "status " + response.status);
        client.assert(lista.every(function (p) { return p.categoria === "LIVROS"; }), "categoria diferente de LIVROS");
        for (var i = 1; i < lista.length; i++) {
            client.assert(lista[i - 1].sku <= lista[i].sku, "fora da ordem de sku: " + lista[i - 1].sku + " > " + lista[i].sku);
        }
        client.assert(lista.some(function (p) { return p.id === Number(client.global.get("livroId")); }), "livro ausente");
    });
%}

### Produto: listar sem categoria inclui os inativos (sucesso)
GET {{host}}/produtos

> {%
    client.test("200 e contém o produto inativo", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.some(function (p) { return p.id === Number(client.global.get("inativoId")); }), "inativo ausente");
    });
%}

