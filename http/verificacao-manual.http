### Carrinho: buscar (sucesso)
GET {{host}}/carrinhos/{{carrinhoId}}

> {%
    client.test("200 com os campos do item", function () {
        var item = response.body.itens[0];
        client.assert(response.status === 200, "status " + response.status);
        client.assert(item.produtoId === Number(client.global.get("livroId")), "produtoId " + item.produtoId);
        client.assert(item.precoUnitario === 120 && item.subtotal === 240, JSON.stringify(item));
    });
%}

### Frete: cotação PADRAO para SP com frete grátis (RN04, RN05, RN07)
POST {{host}}/fretes/cotacao
Content-Type: application/json

{
  "destino": {"cep": "01001000", "uf": "SP"},
  "modalidade": "PADRAO",
  "itens": [{"produtoId": {{livroId}}, "quantidade": 2}]
}

> {%
    client.test("subtotal 240,00 >= 200,00 na PADRAO: frete grátis, valor 0,00, prazo 3", function () {
        var f = response.body;
        client.assert(response.status === 200, "status " + response.status);
        client.assert(f.freteGratis === true && f.valor === 0 && f.prazoDias === 3, JSON.stringify(f));
        client.assert(f.pesoTotalGramas === 1600 && f.modalidade === "PADRAO", JSON.stringify(f));
    });
%}

### Frete: cotação EXPRESSA para AM, com produto inativo (RN04, RN05, RN06)
POST {{host}}/fretes/cotacao
Content-Type: application/json

{
  "destino": {"cep": "69005000", "uf": "AM"},
  "modalidade": "EXPRESSA",
  "itens": [{"produtoId": {{escassoId}}, "quantidade": 1}, {"produtoId": {{inativoId}}, "quantidade": 1}]
}

> {%
    client.test("1800 g = 2 kg; (30,00 + 2 × 2,00) × 1,5 = 51,00; prazo 8 − 2 = 6", function () {
        var f = response.body;
        client.assert(response.status === 200, "status " + response.status);
        client.assert(f.valor === 51 && f.prazoDias === 6 && f.freteGratis === false, JSON.stringify(f));
        client.assert(f.pesoTotalGramas === 1800, "peso " + f.pesoTotalGramas);
    });
%}

### Pedido: criar com cupom (sucesso, RN08 e RN09)
POST {{host}}/pedidos
Content-Type: application/json

{
  "carrinhoId": {{carrinhoId}},
  "cliente": {"nome": "Ana Souza", "email": "ana@exemplo.com"},
  "enderecoEntrega": {"logradouro": "Rua A", "numero": "10", "complemento": "Apto 1", "cidade": "São Paulo", "uf": "SP", "cep": "01001000"},
  "modalidadeFrete": "PADRAO",
  "cupom": "BEMVINDO10"
}

> {%
    client.test("201 com Location /pedidos/{id}", function () {
        client.assert(response.status === 201, "status " + response.status);
        client.assert(response.headers.valueOf("Location") === "/pedidos/" + response.body.id,
            "Location " + response.headers.valueOf("Location"));
    });
    client.test("240,00 − 24,00 + 0,00 = 216,00", function () {
        var p = response.body;
        client.assert(p.status === "AGUARDANDO_PAGAMENTO", "status " + p.status);
        client.assert(p.subtotal === 240 && p.desconto === 24 && p.frete === 0 && p.total === 216, JSON.stringify(p));
    });
    client.test("cliente, endereço e itens", function () {
        var p = response.body;
        client.assert(p.cliente.nome === "Ana Souza" && p.cliente.email === "ana@exemplo.com", JSON.stringify(p.cliente));
        client.assert(p.enderecoEntrega.uf === "SP" && p.enderecoEntrega.complemento === "Apto 1", JSON.stringify(p.enderecoEntrega));
        client.assert(p.modalidadeFrete === "PADRAO", "modalidadeFrete " + p.modalidadeFrete);
        var item = p.itens[0];
        client.assert(p.itens.length === 1 && item.nomeProduto === "Livro de Teste" && item.quantidade === 2, JSON.stringify(p.itens));
        client.assert(item.precoUnitario === 120 && item.subtotal === 240, JSON.stringify(item));
    });
    client.global.set("pedidoId", String(response.body.id));
%}

