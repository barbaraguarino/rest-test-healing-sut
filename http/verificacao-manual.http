### Regra: SKU duplicado
POST {{host}}/produtos
Content-Type: application/json

{
  "sku": "{{livroSku}}",
  "nome": "Livro Repetido",
  "preco": 10.00,
  "categoria": "LIVROS",
  "ativo": true,
  "estoque": 1,
  "pesoGramas": 100,
  "dimensoes": {"alturaCm": 1, "larguraCm": 1, "comprimentoCm": 1}
}

> {%
    client.test("422 SKU já cadastrado", function () {
        client.assert(response.status === 422, "status " + response.status);
        client.assert(response.body.codigo === "REGRA_DE_NEGOCIO", "codigo " + response.body.codigo);
        client.assert(response.body.mensagem === "SKU já cadastrado", "mensagem " + response.body.mensagem);
    });
%}

