# Verificação manual da API cobaia pelo HTTP Client do IntelliJ IDEA.
# Pré-requisito: aplicação rodando em localhost:8080.
# Execute as requisições de cima para baixo: os IDs usados adiante são salvos pelos handlers das
# requisições anteriores. Os SKUs são aleatórios para o arquivo poder ser executado de novo sem
# reiniciar a aplicação.

@host = http://localhost:8080

### Produto: criar livro (sucesso)
POST {{host}}/produtos
Content-Type: application/json

{
  "sku": "LIV-{{$random.alphanumeric(8)}}",
  "nome": "Livro de Teste",
  "descricao": "Livro usado na verificação manual",
  "preco": 120.00,
  "categoria": "LIVROS",
  "ativo": true,
  "estoque": 5,
  "pesoGramas": 800,
  "dimensoes": {"alturaCm": 20, "larguraCm": 14, "comprimentoCm": 3},
  "tags": ["promo", "novo"]
}

> {%
    client.test("201 com Location /produtos/{id}", function () {
        client.assert(response.status === 201, "status " + response.status);
        client.assert(response.headers.valueOf("Location") === "/produtos/" + response.body.id,
            "Location " + response.headers.valueOf("Location"));
    });
    client.test("campos da resposta", function () {
        var p = response.body;
        client.assert(p.nome === "Livro de Teste" && p.preco === 120 && p.categoria === "LIVROS", "nome/preco/categoria");
        client.assert(p.ativo === true && p.estoque === 5 && p.pesoGramas === 800, "ativo/estoque/pesoGramas");
        client.assert(p.dimensoes.alturaCm === 20 && p.dimensoes.larguraCm === 14 && p.dimensoes.comprimentoCm === 3, "dimensoes");
        client.assert(JSON.stringify(p.tags) === '["promo","novo"]', "tags fora da ordem enviada: " + JSON.stringify(p.tags));
    });
    client.global.set("livroId", String(response.body.id));
    client.global.set("livroSku", response.body.sku);
%}

### Produto: criar produto inativo, sem descrição e sem tags (sucesso)
POST {{host}}/produtos
Content-Type: application/json

{
  "sku": "ELE-{{$random.alphanumeric(8)}}",
  "nome": "Fone Inativo",
  "preco": 50.00,
  "categoria": "ELETRONICOS",
  "ativo": false,
  "estoque": 10,
  "pesoGramas": 300,
  "dimensoes": {"alturaCm": 5, "larguraCm": 5, "comprimentoCm": 5}
}

> {%
    client.test("201, descricao null e tags vazia", function () {
        client.assert(response.status === 201, "status " + response.status);
        client.assert(response.body.descricao === null, "descricao " + response.body.descricao);
        client.assert(Array.isArray(response.body.tags) && response.body.tags.length === 0, "tags " + JSON.stringify(response.body.tags));
    });
    client.global.set("inativoId", String(response.body.id));
%}

