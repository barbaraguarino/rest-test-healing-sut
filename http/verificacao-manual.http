### Erro: obrigatórios ausentes em objeto aninhado, campos ordenados
POST {{host}}/produtos
Content-Type: application/json

{
  "sku": "LIV-{{$random.alphanumeric(8)}}",
  "preco": 10.00,
  "categoria": "LIVROS",
  "ativo": true,
  "estoque": 1,
  "pesoGramas": 100,
  "dimensoes": {"larguraCm": 10, "comprimentoCm": 10}
}

> {%
    client.test("400 VALIDACAO com campos = [dimensoes.alturaCm, nome]", function () {
        client.assert(response.status === 400, "status " + response.status);
        client.assert(response.body.codigo === "VALIDACAO", "codigo " + response.body.codigo);
        var nomes = response.body.campos.map(function (c) { return c.campo; });
        client.assert(JSON.stringify(nomes) === '["dimensoes.alturaCm","nome"]', JSON.stringify(nomes));
    });
%}

