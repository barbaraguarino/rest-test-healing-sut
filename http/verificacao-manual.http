###
POST {{host}}/carrinhos/{{carrinhoD}}/itens
Content-Type: application/json

{"produtoId": {{baratoId}}, "quantidade": 1}

###
POST {{host}}/pedidos
Content-Type: application/json

{
  "carrinhoId": {{carrinhoD}},
  "cliente": {"nome": "Ana Souza", "email": "ana@exemplo.com"},
  "enderecoEntrega": {"logradouro": "Rua A", "numero": "10", "cidade": "São Paulo", "uf": "SP", "cep": "01001000"},
  "modalidadeFrete": "PADRAO",
  "cupom": "BEMVINDO10"
}

> {%
    client.test("422 condição do cupom (subtotal 10,00)", function () {
        client.assert(response.status === 422, "status " + response.status);
        client.assert(response.body.mensagem.indexOf("condição do cupom") >= 0, "mensagem " + response.body.mensagem);
    });
%}

### Regra RN10: pedido de carrinho vazio (o carrinho do primeiro pedido foi esvaziado)
POST {{host}}/pedidos
Content-Type: application/json

{
  "carrinhoId": {{carrinhoId}},
  "cliente": {"nome": "Ana Souza", "email": "ana@exemplo.com"},
  "enderecoEntrega": {"logradouro": "Rua A", "numero": "10", "cidade": "São Paulo", "uf": "SP", "cep": "01001000"},
  "modalidadeFrete": "PADRAO"
}

> {%
    client.test("422 carrinho vazio", function () {
        client.assert(response.status === 422, "status " + response.status);
        client.assert(response.body.mensagem.indexOf("carrinho vazio") >= 0, "mensagem " + response.body.mensagem);
    });
%}

### Regra RN11: cancelar pedido já cancelado
POST {{host}}/pedidos/{{pedidoId}}/cancelamento

> {%
    client.test("422 só cancela aguardando pagamento", function () {
        client.assert(response.status === 422, "status " + response.status);
        client.assert(response.body.mensagem.indexOf("aguardando pagamento") >= 0, "mensagem " + response.body.mensagem);
    });
%}

### Contrato OpenAPI gerado
GET {{host}}/v3/api-docs

> {%
    var api = response.body;
    var s = api.components.schemas;

    function ordenado(lista) {
        return JSON.stringify((lista || []).slice().sort());
    }

    function conferirRequired(schema, esperado) {
        client.test("required de " + schema, function () {
            client.assert(s[schema] !== undefined, "schema " + schema + " ausente");
            client.assert(ordenado(s[schema].required) === ordenado(esperado),
                "esperado " + ordenado(esperado) + ", veio " + ordenado(s[schema].required));
        });
    }

    client.test("servidor fixo e relativo", function () {
        client.assert(api.servers.length === 1 && api.servers[0].url === "/", JSON.stringify(api.servers));
    });

    client.test("código de sucesso de cada operação", function () {
        var esperado = {
            "post /produtos": "201", "get /produtos": "200", "get /produtos/{id}": "200",
            "post /carrinhos": "201", "get /carrinhos/{id}": "200", "post /carrinhos/{id}/itens": "200",
            "post /fretes/cotacao": "200",
            "post /pedidos": "201", "get /pedidos/{id}": "200", "post /pedidos/{id}/cancelamento": "200"
        };
        var errados = [];
        Object.keys(esperado).forEach(function (chave) {
            var partes = chave.split(" ");
            var operacao = api.paths[partes[1]] && api.paths[partes[1]][partes[0]];
            var codigos = operacao ? Object.keys(operacao.responses) : ["(operação ausente)"];
            if (codigos.length !== 1 || codigos[0] !== esperado[chave]) {
                errados.push(chave + " = " + codigos.join(","));
            }
        });
        client.assert(errados.length === 0, "esperado só o código de sucesso; veio: " + errados.join("; "));
    });

    client.test("nenhum schema de erro no contrato", function () {
        client.assert(s.ErroResponse === undefined && s.CampoErro === undefined, "ErroResponse/CampoErro presente");
    });

    conferirRequired("ProdutoRequest", ["sku", "nome", "preco", "categoria", "ativo", "estoque", "pesoGramas", "dimensoes"]);
    conferirRequired("DimensoesRequest", ["alturaCm", "larguraCm", "comprimentoCm"]);
    conferirRequired("ItemCarrinhoRequest", ["produtoId", "quantidade"]);
    conferirRequired("CotacaoFreteRequest", ["destino", "modalidade", "itens"]);
    conferirRequired("DestinoRequest", ["cep", "uf"]);
    conferirRequired("ItemCotacaoRequest", ["produtoId", "quantidade"]);
    conferirRequired("PedidoRequest", ["carrinhoId", "cliente", "enderecoEntrega", "modalidadeFrete"]);
    conferirRequired("ClienteRequest", ["nome", "email"]);
    conferirRequired("EnderecoRequest", ["logradouro", "numero", "cidade", "uf", "cep"]);

    client.test("enums", function () {
        client.assert(ordenado(s.ProdutoRequest.properties.categoria.enum) === ordenado(["ELETRONICOS", "LIVROS", "VESTUARIO", "CASA"]), "categoria");
        client.assert(ordenado(s.CotacaoFreteRequest.properties.modalidade.enum) === ordenado(["PADRAO", "EXPRESSA"]), "modalidade");
        client.assert(s.DestinoRequest.properties.uf.enum.length === 27, "uf do destino");
        client.assert(s.EnderecoRequest.properties.uf.enum.length === 27, "uf do endereço");
        client.assert(ordenado(s.PedidoResponse.properties.status.enum) === ordenado(["AGUARDANDO_PAGAMENTO", "CANCELADO"]), "status");
    });

    client.test("nenhum limite de negócio no contrato", function () {
        var texto = JSON.stringify(api);
        client.assert(texto.indexOf('"maximum"') === -1, "há \"maximum\" no contrato");
        client.assert(texto.indexOf("BEMVINDO10") === -1, "o cupom aparece no contrato");
    });
%}
