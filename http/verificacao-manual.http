### Regra RN03 no pedido: pedido do carrinho A consome o estoque (RN05 com 3 kg)
POST {{host}}/pedidos
Content-Type: application/json

{
  "carrinhoId": {{carrinhoA}},
  "cliente": {"nome": "Bruno Lima", "email": "bruno@exemplo.com"},
  "enderecoEntrega": {"logradouro": "Rua B", "numero": "20", "cidade": "Campinas", "uf": "SP", "cep": "13010000"},
  "modalidadeFrete": "PADRAO"
}

> {%
    client.test("201; 3000 g = 3 kg: frete 15,00 + 3 × 2,00 = 21,00; total 60,00 + 21,00 = 81,00", function () {
        var p = response.body;
        client.assert(response.status === 201, "status " + response.status);
        client.assert(p.subtotal === 60 && p.desconto === 0 && p.frete === 21 && p.total === 81, JSON.stringify(p));
        client.assert(p.enderecoEntrega.complemento === null, "complemento " + p.enderecoEntrega.complemento);
    });
%}

